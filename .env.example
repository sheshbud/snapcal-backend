# Required
ANTHROPIC_API_KEY=sk-ant-...
# Recommended: lock CORS to your app URL
ALLOWED_ORIGIN=https://snapcal.vercel.app
# Optional shared key (also set VITE_APP_KEY in the web app to match)
APP_SHARED_KEY=
# Google OAuth (for "Add to Google Calendar"). Secret stays server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
